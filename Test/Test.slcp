- {id: emlib_adc}
- {id: glib}
- {id: lpm013m126a}
- {id: sl_system}
- {id: sleeptimer}
- {id: zigbee_mfglib}
define:
- {name: DEBUG_EFM}
ui_hints:
  highlight:
